{
  "name": "notfckbot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src admin/js cleanup-db.js reset-db.js fix-watchlist-ids.js",
    "lint:fix": "eslint src admin/js cleanup-db.js reset-db.js fix-watchlist-ids.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"admin/js/*.js\" \"admin/css/*.css\" \"admin/*.html\" cleanup-db.js reset-db.js fix-watchlist-ids.js package.json",
    "format:check": "prettier --check \"src/**/*.js\" \"admin/js/*.js\" \"admin/css/*.css\" \"admin/*.html\" cleanup-db.js reset-db.js fix-watchlist-ids.js package.json",
    "typecheck": "tsc -p admin/jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.5",
    "mariadb": "2.5.6",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.7",
    "socks-proxy-agent": "^8.0.5",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
