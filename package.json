{
  "name": "notfckbot",
  "version": "1.0.0",
  "description": "Telegram bot that tracks TV series and films via TMDB, with an admin panel",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src admin/js tests/unit reset-db.js",
    "lint:fix": "eslint src admin/js tests/unit reset-db.js --fix",
    "format": "prettier --write \"src/**/*.js\" \"admin/js/*.js\" \"admin/css/*.css\" \"admin/*.html\" \"tests/unit/*.js\" reset-db.js package.json",
    "format:check": "prettier --check \"src/**/*.js\" \"admin/js/*.js\" \"admin/css/*.css\" \"admin/*.html\" \"tests/unit/*.js\" reset-db.js package.json",
    "typecheck": "tsc -p admin/jsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "axios": "^1.13.6",
    "cacache": "^20.0.4",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.5",
    "lru-cache": "^11.5.3",
    "mariadb": "2.5.6",
    "multer": "^2.5.0",
    "node-cron": "^4.2.1",
    "pino": "^10.4.0",
    "piscina": "^5.3.2",
    "satori": "^0.63.2",
    "sequelize": "^6.37.7",
    "socks-proxy-agent": "^8.0.5",
    "telegraf": "^4.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "eslint": "^9.39.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
