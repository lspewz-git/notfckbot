# Токен бота от @BotFather
BOT_TOKEN=ваш_токен_от_BotFather

# API-ключ TMDB (themoviedb.org) — Read Access Token
TMDB_API_KEY=ваш_ключ_от_themoviedb.org

# База данных
DB_HOST=db
DB_NAME=series_bot
DB_USER=bot_user
DB_PASSWORD=bot_password
MARIADB_ROOT_PASSWORD=root_password

# Необязательно: прокси для TMDB и Telegram (см. раздел «Прокси» в README)
TMDB_PROXY_URL=

# Необязательно: ключ kinopoiskapiunofficial.tech — запасной источник ID Кинопоиска
# для ссылок на Кинопоиск и SSPoisk (основной источник — Wikidata, ключ не нужен)
KINOPOISK_API_KEY=

# Необязательно: как часто проверять новые серии и фильмы, в часах (1, 2, 3, 4, 6, 8, 12 или 24).
# По умолчанию 3. Меняется после перезапуска бота.
UPDATE_INTERVAL_HOURS=
