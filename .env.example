# Токен бота от @BotFather
BOT_TOKEN=ваш_токен_от_BotFather

# API-ключ TMDB (themoviedb.org) — Read Access Token
TMDB_API_KEY=ваш_ключ_от_themoviedb.org

# База данных
DB_HOST=db
DB_NAME=series_bot
DB_USER=bot_user
DB_PASSWORD=bot_password
MARIADB_ROOT_PASSWORD=root_password

# Необязательно: прокси для TMDB и Telegram (см. раздел «Прокси» в README)
TMDB_PROXY_URL=

# Необязательно: ключ kinopoiskapiunofficial.tech — запасной источник ID Кинопоиска
# для ссылок на Кинопоиск и SSPoisk (основной источник — Wikidata, ключ не нужен)
KINOPOISK_API_KEY=

# Необязательно: как часто проверять новые серии и фильмы, в часах (1, 2, 3, 4, 6, 8, 12 или 24).
# По умолчанию 3. Меняется после перезапуска бота.
UPDATE_INTERVAL_HOURS=

# Необязательно: сколько дней хранить журнал изменений чатов (7, 30, 90 или 365). По умолчанию 30.
# Меняется в панели: Settings → Bot.
CHANGES_KEEP_DAYS=

# Вход в панель: через бота («Войти через Telegram» или команда /login), паролей нет.
# ADMIN_USERS — Telegram id админов (вся панель), ACCOUNT_USERS — пользователи (только свои чаты),
# через запятую. PANEL_URL — адрес панели для ссылки из /login, например http://192.168.2.112.
# Если Telegram недоступен: docker compose exec app node login-link.js — печатает ссылку для входа.
ADMIN_USERS=
ACCOUNT_USERS=
PANEL_URL=
